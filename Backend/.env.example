# Template for environment files. Copy to .env.local / .env.staging / .env.production
# and fill in real values. Never commit the real files (all .env.* are gitignored).
#
# The app picks the file based on APP_ENV (default: local):
#   PowerShell:  $env:APP_ENV = "staging"
#   cmd:         set APP_ENV=staging
#   Linux/macOS: export APP_ENV=staging
#
# Passwords can contain special characters as-is (no URL-encoding needed).
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Vendor
DB_DRIVER=psycopg2
